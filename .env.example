# Create a Razorpay webhook in Dashboard > Account & Settings > Webhooks.
# Set its URL to https://your-domain.example/webhook, subscribe to payment.captured,
# and copy its webhook secret here.
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret

# ₹19 in Razorpay's smallest currency unit (paise).
RAZORPAY_EXPECTED_AMOUNT=1900

# The publicly accessible HTTPS URL where this server is deployed.
PUBLIC_BASE_URL=https://your-domain.example

# Optional: defaults to 3000.
PORT=3000